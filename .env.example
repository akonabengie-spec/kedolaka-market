PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/kundu_market
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional password recovery mail delivery. Recovery email is unavailable without these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Payment methods are disabled by default. Sandbox records are never real payments.
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_RESERVATION_MINUTES=30
PAYMENT_MANUAL_RESERVATION_MINUTES=1440
PAYMENT_MANUAL_BANK_TRANSFER_ENABLED=false
PAYMENT_MANUAL_BANK_TRANSFER_INSTRUCTIONS=
PAYMENT_CASH_ON_DELIVERY_ENABLED=false
PAYMENT_CASH_ON_DELIVERY_INSTRUCTIONS=
PAYMENT_IN_PERSON_ENABLED=false
PAYMENT_IN_PERSON_INSTRUCTIONS=
TEST_DATABASE_URL=postgres://postgres:change-me@localhost:5432/kundu_market_test
